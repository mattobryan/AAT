tion":0.005498,"end_time":"2026-10-21T18:56:36.329624+00:00","exception":false,"start_time":"2026-10-21T18:56:36.324126+00:00","status":"completed"},"tags":[]},"source":["## Day 1: GPU smoke test and timing (about 15 min)\n","Runs once. Set `SMOKE = False` after it printed `SMOKE OK`, so *Save & Run All* skips it from then on. It covers a fixed-ε AutoAttack + unseen-grid\n","evaluation on 100 images, so evaluation bugs show up now and not after hours of training. Send the two `epoch_time_s` numbers back to refit the budget.\n"]},{"cell_type":"code","execution_count":5,"id":"cda33a02","metadata":{"execution":{"iopub.execute_input":"2026-10-21T18:56:36.343769Z","iopub.status.busy":"2026-10-21T18:56:36.342976Z","iopub.status.idle":"2026-10-21T18:56:36.347742Z","shell.execute_reply":"2026-10-21T18:56:36.34688Z"},"papermill":{"duration":0.013257,"end_time":"2026-10-21T18:56:36.349312+00:00","exception":false,"start_time":"2026-10-21T18:56:36.336055+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["SMOKE = False  # passed on 2026-10-10; set True to re-run\n","if SMOKE:\n","    get_ipython().system('bash scripts/smoke_gpu.sh')\n"]},{"cell_type":"markdown","id":"d8e47424","metadata":{"papermill":{"duration":0.004934,"end_time":"2026-10-21T18:56:36.359623+00:00","exception":false,"start_time":"2026-10-21T18:56:36.354689+00:00","status":"completed"},"tags":[]},"source":["## Helpers and plan\n","`SESSION_H` is this session's training budget; each stage gets whatever is left, so the notebook never starts a run it cannot finish before Kaggle's 12 h limit.\n","H1/H4 need `v3a_max` (matched control), `aat_full`, `aat_full_no_l2`, `ramp`, `eat`; H2 needs `v3b_classeps` vs `v3a_max`. Seed 0 first, then seed 1 for the headline pair plus the baselines.\n","Note: `configs/ramp.yaml` is our re-implementation (it still carries a TODO to check against the official code); the locked official RAMP numbers are in `baselines/results/` and are a separate, not matched, comparison."]},{"cell_type":"code","execution_count":6,"id":"935e07bf","metadata":{"execution":{"iopub.execute_input":"2026-10-21T18:56:36.372094Z","iopub.status.busy":"2026-10-21T18:56:36.371811Z","iopub.status.idle":"2026-10-21T18:56:36.387228Z","shell.execute_reply":"2026-10-21T18:56:36.386284Z"},"papermill":{"duration":0.024201,"end_time":"2026-10-21T18:56:36.388999+00:00","exception":false,"start_time":"2026-10-21T18:56:36.364798+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["import os, time, subprocess\n","from aat import hub\n","SESSION_H = 11.0\n","RUN_SQUINT = True    # True: also train/evaluate squint (seed-0 pair is already trained on HF: this runs its standard + adaptive evaluations)\n","RUN_OLD = False    # earlier stages (5, 5c, realloc and their evals) are finished and pushed to the Hub; True re-checks them (pulls every final.pt, several minutes)\n","RUN_MAIN = False   # the main matrix (stages 1-3) finished on 2026-10-10; set True to resume or re-run it\n","T0 = time.time()\n","SEED0 = [('v3a_max', 'aat_full'), ('ramp', 'eat'), ('aat_full_no_l2', 'v3b_classeps')]   # pairs run in parallel, one per GPU\n","SEED1 = [('v3a_max', 'aat_full'), ('ramp', 'eat')]                                         # seeds 1 and 2: headline pair + baselines\n","SEED2 = SEED1\n","# budget-matched AAT (class eps starts at nominal, mean eps held at nominal); 'config:seed' sets that run's seed\n","NOM = [('aat_full_nominal:0', 'aat_full_nominal:1'), ('aat_full_nominal:2', 'v3b_classeps_nominal:0'),\n","       ('v3a_max_eps075:0', 'v3a_max_eps075:1'), ('v3a_max_eps075:2',),\n","       ('aat_full_free:0', 'aat_full_free:1'), ('v3a_max_eps125:0', 'v3a_max_eps125:1')]\n","NOM_RUNS = ['aat_full_nominal_s0', 'aat_full_nominal_s1', 'aat_full_nominal_s2', 'v3b_classeps_nominal_s0',\n","            'v3a_max_eps075_s0', 'v3a_max_eps075_s1', 'v3a_max_eps075_s2',\n","            'aat_full_free_s0', 'aat_full_free_s1', 'v3a_max_eps125_s0', 'v3a_max_eps125_s1']\n","# squint: input-conditioned model (gate head + gated BatchNorm); the nogate arm is the ablation without gate supervision\n","SQUINT = [('squint_v0:0', 'squint_v0_nogate:0')]   # one seed first: the gate only reaches about 0.4 to 0.5 accuracy in training, so a second pair waits for the seed-0 result\n","SQUINT_RUNS = ['squint_v0_s0', 'squint_v0_nogate_s0']\n","ADAPT_BASE = ['v3a_max_s0', 'v3a_max_s1']   # plain model with the same number of extra attacks: the matched baseline for squint\n","# high-budget end of the clean-vs-union frontier: does AAT stay above the fixed-eps curve at 1.25x, and where does 1.5x land\n","HIGH = [('aat_full_eps125:0', 'aat_full_eps125:1'), ('v3a_max_eps150:0', 'v3a_max_eps150:1')]\n","HIGH_RUNS = ['aat_full_eps125_s0', 'aat_full_eps125_s1', 'v3a_max_eps150_s0', 'v3a_max_eps150_s1']\n","# pins the frontier at clean ~81 (fixed 1.125x) and tests per-norm budget reallocation (linf 1.0x, l2 0.75x, l1 1.5x)\n","REALLOC = [('v3a_max_eps112:0', 'v3a_max_eps112:1'), ('v3a_max_realloc:0', 'v3a_max_realloc:1'),\n","           ('v3a_max_realloc_b:0', 'v3a_max_realloc_b:1')]\n","REALLOC_RUNS = ['v3a_max_eps112_s0', 'v3a_max_eps112_s1', 'v3a_max_realloc_s0', 'v3a_max_realloc_s1',\n","                'v3a_max_realloc_b_s0', 'v3a_max_realloc_b_s1']\n","# extra-attack check of the reallocation result: matched extra seeded APGD-CE runs, compare robust with robust_standard in the same file;\n","# the fixed 1.5x run is the comparison for how much a plain model loses to the extra attacks\n","CHECK_RUNS = ['v3a_max_realloc_s0', 'v3a_max_eps150_s0']\n","# norm-level eps controller (v3a_max_normctl: uniform start, controller finds the allocation; _ft: starts at the realloc allocation, gentler alpha)\n","RUN_CTL = True      # 10-epoch fine-tune pair, about 1 h; check its result before spending hours on E80\n","CTL = [('v3a_max_normctl:0', 'v3a_max_normctl_ft:0')]\n","CTL_RUNS = ['v3a_max_normctl_s0', 'v3a_max_normctl_ft_s0']\n","# 80-epoch from-scratch runs (RAMP's schedule length, our training attacks).\n","# A (done 2026-10-21): normctl_ft vs static realloc. The controller lost badly (its 10-step PGD feedback hides that l1 is weak under AutoAttack), and\n","# static realloc reached only 36.8 union because l-inf is 37.0 (RAMP 45.7): the 5-step l-inf training attack does not hold up over 80 epochs.\n","# B: the fixed 1.0x reference at 80 epochs (is realloc above fixed here too?) and realloc with a 10-step l-inf training attack. ~7.3 h in parallel.\n","RUN_E80A, RUN_E80B = False, True\n","E80A = [('v3a_max_normctl_ft_e80:0', 'v3a_max_realloc_e80:0')]\n","E80B = [('v3a_max_e80:0', 'v3a_max_realloc_a10_e80:0')]\n","E80_RUNS = ['v3a_max_normctl_ft_e80_s0', 'v3a_max_realloc_e80_s0', 'v3a_max_e80_s0', 'v3a_max_realloc_a10_e80_s0']\n","EVAL_RUNS = [f'{c}_s0' for p in SEED0 for c in p] + [f'{c}_s1' for p in SEED1 for c in p] + [f'{c}_s2' for p in SEED2 for c in p]\n","\n","def left_h():\n","    return SESSION_H - (time.time() - T0) / 3600\n","\n","def stage(name, cmd):\n","    \"\"\"Run a stage, stream its output, push a phone notification, and stop the notebook if it fails.\"\"\"\n","    get_ipython().system(f'python scripts/stage.py {name} \"{cmd}\"')\n","    if _exit_code != 0:\n","        raise SystemExit(f'stage {name} failed (exit {_exit_code}): see the notification or logs/{name}.txt on Hugging Face')\n","\n","def have(run, f='final.pt'):\n","    \"\"\"True if runs/<run>/<f> exists locally or can be restored from the Hub.\"\"\"\n","    p = f'runs/{run}/{f}'\n","    return os.path.exists(p) or hub.pull(f'aat/{run}/{f}', p)\n","\n","def run_of(job, seed):\n","    cfg, _, own = job.partition(':')\n","    return f'{cfg}_s{own or seed}'\n","\n","def train_pairs(pairs, seed):\n","    for pair in pairs:\n","        todo = [c for c in pair if not have(run_of(c, seed))]\n","        if not todo:\n","            continue\n","        if left_h() < 0.5:\n","            raise SystemExit('session budget used up: Save Version and run the notebook again in a new session')\n","        stage('train_' + '_'.join(todo).replace(':', 's') + f'_s{seed}',\n","              f'bash scripts/run_queue.sh \\\\\"{\" \".join(todo)}\\\\\" \\\\\"seed={seed} train.time_budget_h={left_h():.2f}\\\\\"')\n","        if not all(have(run_of(c, seed)) for c in todo):\n","            raise SystemExit('a run paused at the time budget: Save Version and run the notebook again to resume')"]},{"cell_type":"markdown","id":"06976fb0","metadata":{"papermill":{"duration":0.006283,"end_time":"2026-10-21T18:56:36.400633+00:00","exception":false,"start_time":"2026-10-21T18:56:36.39435+00:00","status":"completed"},"tags":[]},"source":["## Stage 0: shared ℓ∞-AT pretrain (~1–1.5 h, one T4). Every variant fine-tunes from it."]},{"cell_type":"code","execution_count":7,"id":"b8a1326e","metadata":{"execution":{"iopub.execute_input":"2026-10-21T18:56:36.413513Z","iopub.status.busy":"2026-10-21T18:56:36.412811Z","iopub.status.idle":"2026-10-21T18:56:39.099534Z","shell.execute_reply":"2026-10-21T18:56:39.098467Z"},"papermill":{"duration":2.694872,"end_time":"2026-10-21T18:56:39.101227+00:00","exception":false,"start_time":"2026-10-21T18:56:36.406355+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"d0075a6143b14ea78d7493fcd5806435","version_major":2,"version_minor":0},"text/plain":["aat/pretrain_linf_s0/final.pt:   0%|          | 0.00/44.8M [00:00<?, ?B/s]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["[hub] pulled aat/pretrain_linf_s0/final.pt <- matokebryan/aat-checkpoints\n","pretrain_linf_s0 ready\n"]}],"source":["if not have('pretrain_linf_s0'):\n","    stage('pretrain_linf', f'python -m aat.train --config configs/pretrain_linf.yaml --set train.time_budget_h={left_h():.2f}')\n","    assert have('pretrain_linf_s0'), 'pretrain paused at the time budget: run the notebook again'\n","else:\n","    print('pretrain_linf_s0 ready')"]},{"cell_type":"markdow