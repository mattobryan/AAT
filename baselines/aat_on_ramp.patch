     return args
 
 
+def aat_project_mean(eps, nominal, lo, hi):
+    # [aat patch] make mean_c(eps_c) == nominal inside [lo, hi]: rescale+clamp, then exact additive shift on unclamped classes
+    for _ in range(10):
+        eps = (eps * nominal / eps.mean()).clamp(lo, hi)
+    for _ in range(50):
+        diff = nominal - eps.mean()
+        if diff.abs() < 1e-8 * nominal:
+            break
+        free = (eps < hi) if diff > 0 else (eps > lo)
+        if free.sum() == 0:
+            break
+        eps = torch.where(free, eps + diff * eps.numel() / free.sum(), eps).clamp(lo, hi)
+    return eps
+
+
